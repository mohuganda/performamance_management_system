# Generated by setup.sh — do not commit deploy/.env (contains secrets).

# Public access
PUBLIC_HOST=192.168.1.10
HTTP_PORT=80
GATEWAY_PORT=8080

# Demo / data
LOAD_DEMO_DATA=true
IHRIS_USE_DEMO_DATA=true

# Application
APP_NAME=MoH-PMS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.10
APP_KEY=
JWT_SECRET=

# Admin (seeded when LOAD_DEMO_DATA=true / db:seed)
ADMIN_EMAIL=admin@moh.go.ug
ADMIN_PASSWORD=Demo@Moh2026!
ADMIN_NAME="PMS Administrator"

# Super admin (created/updated on every API boot when set — not from backend/.env)
SUPER_ADMIN_EMAIL=super@moh.go.ug
SUPER_ADMIN_PASSWORD=SuperAdmin@Moh2026!
SUPER_ADMIN_NAME="System Super Admin"

# Primary OLTP: postgres (default) or mysql
DB_CONNECTION=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moh_pms
DB_USERNAME=pms
DB_PASSWORD=change_me_pms
DB_SCHEMA=public

# Used when DB_CONNECTION=mysql (mysql compose service)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=moh_pms
MYSQL_USER=pms
MYSQL_PASSWORD=change_me_pms

# Expose data services on host (optional)
EXPOSE_POSTGRES=false
EXPOSE_MYSQL=false
EXPOSE_REDIS=false
POSTGRES_HOST_PORT=5433
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# Frontend build
VITE_API_BASE_URL=/api/v1

# Host nginx (when INSTALL_HOST_NGINX=true)
INSTALL_HOST_NGINX=false
SERVER_NAME=_

# Persistent data on the host (Postgres/MySQL, Redis, API storage/logs, uploaded media)
DATA_DIR=/var/lib/moh-pms
# Profile photos, signatures, and attachments (outside the application tree)
FILE_STORAGE_ROOT=/var/lib/moh-pms/media
# Logical DB dumps (outside app tree). Host path mounted into API container.
DB_BACKUP_DIR=/home/moh-pms/db-backups
DB_BACKUP_USE_DOCKER_EXEC=true
# Optional: run schedule every minute so DailyAt("02:15") fires:
#   docker exec moh-pms-api ./moh-pms-api artisan schedule:run
# Or daily only:
#   15 2 * * * docker exec moh-pms-api ./moh-pms-api artisan backup:database

# Apache Doris analytics (enabled by default; start with docker-compose.analytics.yml)
# Dashboards fall back to the primary OLTP database when Doris is unreachable.
ANALYTICS_DB_ENABLED=true
ANALYTICS_DB_HOST=host.docker.internal
ANALYTICS_DB_PORT=9030
ANALYTICS_DB_DATABASE=moh_pms_analytics
ANALYTICS_DB_USERNAME=root
ANALYTICS_DB_PASSWORD=
