# ==============================================================================
#  PMS iHRIS PWA Environment Configuration Template
# Copy this file to '.env' (or '.env.production') and fill in your values.
# NEVER commit your real '.env' file containing production IPs or API keys to git.
# ==============================================================================

# Frontend API Base URL
# Option 1 (Recommended): Use relative path '/api/v1' to route through local/production reverse proxy.
# Option 2: Use direct backend URL (e.g. 'https://api.yourdomain.gov.ug/api/v1') for standalone deployments.
VITE_API_BASE_URL=/api/v1

# Target Remote MoH Backend Server
# Used by Vite development proxy and Docker Nginx reverse proxy
BACKEND_API_SERVER=http://localhost:8081
BACKEND_API_HOST=localhost:8081
VITE_BACKEND_API_SERVER=http://localhost:8081

# Google Maps API Key for Geocoding and Places Search
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
